# ==========================================
# Application Configuration
# ==========================================
PROJECT_NAME="Agentic AI Integrated Enterprise and Decision Support System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# ==========================================
# Security & JWT Authentication
# ==========================================
# Generate a secure secret using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="insecure-change-me-in-production-dev-secret-key-32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# First Admin Bootstrap Credentials (Optional)
# ==========================================
# Used by `python -m app.core.bootstrap` to create the initial Admin
FIRST_SUPERUSER_EMAIL="admin@enterprise.com"
FIRST_SUPERUSER_PASSWORD="ChangeThisPassword123!"

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL="sqlite:///./data/enterprise.db"

# ==========================================
# AI Provider Configuration (Phase 8+)
# ==========================================
GEMINI_API_KEY=""
