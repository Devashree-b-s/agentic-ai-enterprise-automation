# ==========================================
# Application Configuration
# ==========================================
PROJECT_NAME="Agentic AI Integrated Enterprise and Decision Support System"
ENVIRONMENT="development"
DEBUG=True
API_V1_STR="/api/v1"

# ==========================================
# Security & JWT Authentication
# ==========================================
# Generate a secure secret using: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY="insecure-change-me-in-production-dev-secret-key-32bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ==========================================
# First Admin Bootstrap Credentials (Optional)
# ==========================================
# Used by `python -m app.core.bootstrap` to create the initial Admin
FIRST_SUPERUSER_EMAIL="admin@enterprise.com"
FIRST_SUPERUSER_PASSWORD="<enter-a-strong-admin-password>"

# ==========================================
# Database Configuration
# ==========================================
DATABASE_URL=postgresql://neondb_owner:npg_vJ2eQUw3acOH@ep-spring-unit-beojrbko-pooler.c-9.us-east-2.aws.neon.tech/neondb?sslmode=require&channel_binding=require
HISTORICAL_DATABASE_URL="sqlite:///C:/path/to/project/data/historical.db"

# ==========================================
# AI Provider Configuration (Milestone 7)
# ==========================================
LLM_PROVIDER="groq"
GROQ_API_KEY="your groq api key here"
GROQ_MODEL="qwen/qwen3.8-27b"

GEMINI_API_KEY="your gemini api here"
GEMINI_MODEL="gemini-1.5-flash"

# ==========================================
# Agent Limits & Guardrails
# ==========================================
AGENT_MAX_ITERATIONS=10
AGENT_MAX_TOOL_CALLS=15
AGENT_TIMEOUT_SECONDS=60
